          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/List"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
